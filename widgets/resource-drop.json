{
  "id": "resource-drop",
  "name": "Resource Drop",
  "author": "Bunker",
  "version": "1.0.0",
  "description": "Reward everyone online with a resource, for events or as an apology after downtime.",
  "controls": [
    { "type": "choice", "id": "item", "label": "Resource", "options": [ "wood", "stones", "metal.fragments", "sulfur", "scrap", "lowgradefuel", "cloth", "leather" ] },
    { "type": "number", "id": "amount", "label": "Amount each", "default": 500, "min": 1, "max": 5000 },
    {
      "type": "button",
      "text": "Give to everyone",
      "confirm": "Give {amount} x {item} to EVERY player on the server?",
      "commands": [
        "inventory.giveall {item} {amount}",
        "say \"Everyone just received {amount} {item}!\""
      ]
    }
  ]
}
