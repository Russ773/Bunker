{
  "id": "plugin-control",
  "name": "Oxide Plugin Control",
  "author": "Bunker",
  "version": "1.0.3",
  "description": "List your Oxide/uMod plugins and reload, unload or load one by name. Needs Oxide (uMod) installed on the server. For Carbon servers use Carbon Plugin Control instead.",
  "controls": [
    { "type": "output", "id": "plugins", "format": "plugins", "pick": "plugin", "height": 380 },
    { "type": "button", "text": "List plugins", "output": "plugins", "commands": [ "oxide.plugins" ] },
    { "type": "separator" },
    { "type": "text", "id": "plugin", "label": "Plugin name", "placeholder": "Welcomer" },
    { "type": "button", "style": "ghost", "text": "Reload", "output": "plugins", "commands": [ "oxide.reload {plugin}" ] },
    { "type": "button", "style": "ghost", "text": "Load", "output": "plugins", "commands": [ "oxide.load {plugin}" ] },
    { "type": "button", "style": "ghost", "text": "Unload", "output": "plugins", "confirm": "Unload the plugin {plugin}?", "commands": [ "oxide.unload {plugin}" ] }
  ]
}
