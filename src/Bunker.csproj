<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Bunker.ico</ApplicationIcon>
    <Version>1.0.3</Version>
    <AssemblyName>Bunker</AssemblyName>
    <Product>Bunker</Product>
    <RootNamespace>Bunker</RootNamespace>
    <!-- Our custom controls are never edited in the Visual Studio designer, so designer-serialization warnings do not apply. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- Build number: CI passes -p:BuildNumber=<run number>. Local builds use the number of 10-minute
       intervals since 12 Oct 2026, so it goes up with every build. It becomes the 4th part of the version. -->
  <PropertyGroup>
    <BuildNumber Condition="'$(BuildNumber)' == ''">$([System.Math]::Floor($([MSBuild]::Divide($([System.DateTime]::UtcNow.Subtract($([System.DateTime]::Parse('2026-10-12'))).TotalMinutes), 10))))</BuildNumber>
    <AssemblyVersion>$(Version).$(BuildNumber)</AssemblyVersion>
    <FileVersion>$(Version).$(BuildNumber)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\logo-512.png" LogicalName="logo.png" />
    <EmbeddedResource Include="..\assets\items-fallback.json" LogicalName="items-fallback.json" />
  </ItemGroup>


  <ItemGroup>
    <!-- Turns the item pictures (WebP) into PNG. Its native library is copied next to Bunker.exe. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <!-- SkiaSharp ships a ~96 MB symbols file for its native library; users do not need it. -->
  <Target Name="DropSkiaSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'libSkiaSharp.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Bunker.Tests" />
  </ItemGroup>

</Project>
